{
  "name": "vertixhub-ecommerce",
  "version": "1.0.0",
  "description": "VertixHub: PC parts storefront (Next.js static export) with a Neon Functions API",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api:dev": "tsx --env-file=.env scripts/dev-api.ts",
    "db:migrate": "tsx --env-file=.env scripts/db-migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/db-seed.ts",
    "build:static": "cross-env STATIC_EXPORT=true next build",
    "serve": "npx serve out"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@neon/config": "^1.8.2",
    "@neon/functions": "^0.11.0",
    "hono": "^4.13.9",
    "lucide-react": "^0.294.0",
    "next": "14.0.4",
    "pg": "^8.23.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.4.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "20.10.4",
    "@types/pg": "^8.23.1",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.17",
    "autoprefixer": "10.4.16",
    "cross-env": "^10.1.0",
    "eslint": "8.55.0",
    "eslint-config-next": "14.0.4",
    "postcss": "8.4.32",
    "tailwindcss": "3.3.6",
    "tsx": "^4.23.15",
    "typescript": "5.3.3"
  }
}
