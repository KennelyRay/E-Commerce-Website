# Copy to .env and fill in. Never commit .env.

# Neon Postgres. Pooled URL for the API, direct (unpooled) URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Password for the "Admin" account created by `npm run db:seed` (12+ characters).
ADMIN_PASSWORD=""

# Browser origins the local API accepts (comma separated).
ALLOWED_ORIGINS="http://localhost:3000"

# Where the storefront calls the API. Local runner by default.
NEXT_PUBLIC_API_URL="http://localhost:8787"
